# ========================
# Application
# ========================
APP_ENV=development

# ========================
# Database — PostgreSQL
# ========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=personal_os
POSTGRES_USER=personal_os
