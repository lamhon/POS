ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=personal_os;Username=personal_os;Password=change-me

# ========================
# Frontend (public — NEXT_PUBLIC_* only)
# ========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
